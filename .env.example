# api/ — port d'écoute du service (8081 côté serveur, fixé par le gabarit ; modifiable en local)
PORT=8081

# api/ — clé virtuelle de la passerelle LLM de la plateforme (secret/core/llm-vkeys, champ "team09").
# Jamais la vraie clé du fournisseur : une clé par app, quota géré par la plateforme.
LLM_API_KEY=
